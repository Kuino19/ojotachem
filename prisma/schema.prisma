generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String      @id @default(cuid())
  name            String
  casNumber       String
  chemicalFormula String
  purity          String
  grade           String
  description     String
  priceNgn        Float
  stockQuantity   Int
  category        String
  packaging       String
  imageUrl        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  orderItems      OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  userId          String?     // Clerk User ID (optional for guest checkout if allowed, but we require auth)
  userEmail       String
  customerName    String
  companyName     String?
  status          OrderStatus @default(PENDING)
  deliveryType    String
  deliveryFee     Float
  subtotal        Float
  totalAmount     Float
  paymentRef      String?     // Paystack reference
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  priceAtTime Float    // To lock in the price at checkout
}

enum OrderStatus {
  PENDING
  PAID
  DISPATCHED
  DELIVERED
  CANCELLED
}
